rules_version = '2';

// HireTrack's security rules. Firebase checks every read and write against these on Google's
// servers, so they protect your data even if someone changes the app's code in their browser.
//
// Everything belongs to one person, under users/{their id}:
//   users/{uid}              profile: name and weekly goal
//   users/{uid}/jobs/{id}    jobs
//   users/{uid}/docs/{id}    CV versions and cover letters
// Only that person can read or change any of it. Writes are also checked: only known fields,
// the right types, and text no longer than the app allows (the same limits as lib/jobs.ts and
// lib/documents.ts), so nobody can fill your account with junk through the API.
// Anything not matched below is refused.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // "" or a date like 2026-11-09
    function dateOrEmpty(v) {
      return v is string && (v == "" || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // A link must be empty or start with http(s)://, so a "javascript:" link can't be saved
    function linkOrEmpty(v, max) {
      return shortText(v, max) && (v == "" || v.matches('^https?://.*'));
    }

    function goodProfile(d) {
      return d.keys().hasOnly(['name', 'weeklyGoal'])
        && shortText(d.get('name', ''), 40)
        && d.get('weeklyGoal', 0) is int && d.get('weeklyGoal', 0) >= 0 && d.get('weeklyGoal', 0) <= 50;
    }

    function goodJob(d) {
      return d.keys().hasOnly([
          'company', 'role', 'link', 'location', 'mode', 'salary', 'source', 'stage', 'outcome', 'accepted',
          'appliedOn', 'heardBackOn', 'followUpOn', 'followUpNote', 'contactName', 'contactEmail', 'cvId', 'coverId',
          'notes', 'research', 'interviews', 'checklist', 'questions', 'history', 'order', 'example', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['company', 'role', 'stage', 'history', 'order', 'createdAt', 'updatedAt'])
        && shortText(d.company, 80)
        && shortText(d.role, 100)
        && linkOrEmpty(d.get('link', ''), 500)
        && shortText(d.get('location', ''), 80)
        && d.get('mode', '') in ['', 'onsite', 'hybrid', 'remote']
        && shortText(d.get('salary', ''), 60)
        && shortText(d.get('source', ''), 40)
        && d.stage in ['saved', 'applied', 'interview', 'offer', 'closed']
        && d.get('outcome', '') in ['', 'rejected', 'noReply', 'withdrew', 'declined']
        && d.get('accepted', false) is bool
        && dateOrEmpty(d.get('appliedOn', ''))
        && dateOrEmpty(d.get('heardBackOn', ''))
        && dateOrEmpty(d.get('followUpOn', ''))
        && shortText(d.get('followUpNote', ''), 140)
        && shortText(d.get('contactName', ''), 80)
        && shortText(d.get('contactEmail', ''), 120)
        && shortText(d.get('cvId', ''), 40)
        && shortText(d.get('coverId', ''), 40)
        && shortText(d.get('notes', ''), 2000)
        && shortText(d.get('research', ''), 2000)
        // Lists can't be checked item by item in rules, so their length is limited instead
        // (and Firestore limits a whole job to 1 MB)
        && d.get('interviews', []) is list && d.get('interviews', []).size() <= 10
        && d.get('checklist', []) is list && d.get('checklist', []).size() <= 30
        && d.get('questions', []) is list && d.get('questions', []).size() <= 30
        && d.history is list && d.history.size() <= 40
        && d.order is number
        && d.get('example', false) is bool
        && d.createdAt is number
        && d.updatedAt is number;
    }

    function goodDoc(d) {
      return d.keys().hasOnly(['kind', 'name', 'link', 'notes', 'createdAt'])
        && d.kind in ['cv', 'cover']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && linkOrEmpty(d.get('link', ''), 500)
        && shortText(d.get('notes', ''), 500)
        && d.createdAt is number;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && goodProfile(request.resource.data);

      match /jobs/{jobId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && goodJob(request.resource.data);
      }

      match /docs/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && goodDoc(request.resource.data);
      }
    }
  }
}
